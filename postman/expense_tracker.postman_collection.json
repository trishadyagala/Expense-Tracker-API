{
  "info": {
    "name": "Expense Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "Add expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"expense\",\n  \"amount\": 250.5,\n  \"category\": \"food\",\n  \"description\": \"Groceries\",\n  \"date\": \"2026-10-28\"\n}"
        }
      }
    },
    {
      "name": "Add income",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"income\",\n  \"amount\": 50000,\n  \"category\": \"salary\"\n}"
        }
      }
    },
    {
      "name": "List all",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        }
      }
    },
    {
      "name": "Filter by category and date",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions?category=food&start_date=2026-10-01&end_date=2026-10-31",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions"
          ],
          "query": [
            {
              "key": "category",
              "value": "food"
            },
            {
              "key": "start_date",
              "value": "2026-10-01"
            },
            {
              "key": "end_date",
              "value": "2026-10-31"
            }
          ]
        }
      }
    },
    {
      "name": "Get one",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions",
            "1"
          ]
        }
      }
    },
    {
      "name": "Update",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 300\n}"
        }
      }
    },
    {
      "name": "Delete",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions",
            "1"
          ]
        }
      }
    },
    {
      "name": "Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/summary",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "summary"
          ]
        }
      }
    },
    {
      "name": "Categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
    {
      "name": "Invalid amount (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/transactions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"expense\",\n  \"amount\": -5,\n  \"category\": \"food\"\n}"
        }
      }
    }
  ]
}